# Requestarr — copy this file to .env (cp .env.example .env). You shouldn't
# need to touch much else in it.
#
# Everything (Discord bot token, Sonarr/Radarr, quality profiles/root
# folders, dry-run mode, and your admin login) is configured through the
# setup wizard in your browser after you start the container:
# http://<this-machine's-ip>:8787
#
# APP_PORT and DATA_DIR below are the only things actually meant to be
# hand-edited, and only if you need to change them from the defaults.

APP_PORT=8787
DATA_DIR=/data

# Optional: GET /api/jobs/active-downloads (for an external download-queue
# helper). By default only the admin login can read it. Set an API key to let
# a script read it with an "X-Api-Key: <key>" header instead:
# ACTIVE_DOWNLOADS_API_KEY=
# Or, on a trusted LAN only, leave it open with no auth at all (pre-1.1 behaviour):
# ACTIVE_DOWNLOADS_ALLOW_UNAUTHENTICATED=false
