# Requestarr — you shouldn't need to touch this file.
#
# Everything (Discord bot token, Sonarr/Radarr, quality profiles/root
# folders, dry-run mode, and your admin login) is configured through the
# setup wizard in your browser after you start the container:
# http://<this-machine's-ip>:8787
#
# APP_PORT and DATA_DIR below are the only things actually meant to be
# hand-edited, and only if you need to change them from the defaults.

APP_PORT=8787
DATA_DIR=/data
